# PART 5: INVESTMENT OPTIONS

print("\n===== INVESTMENT OPTIONS =====")

print("Option 1: Growth Investment (No Dividend)")
print("Option 2: Dividend Investment (50% Growth + 50% Dividend)")

choice = input("\nWhich investment would you like? (1 or 2): ")

if choice == "1":

    print("\n===== GROWTH INVESTMENT =====")

    growth_value = principal * (1 + rate) ** years
    growth_profit = growth_value - principal

    print(f"Annual Growth Rate: {rate * 100:.2f}%")
    print(f"Future Investment Value: ${growth_value:,.2f}")
    print(f"Total Investment Return: ${growth_profit:,.2f}")

elif choice == "2":

    print("\n===== DIVIDEND INVESTMENT =====")

    # Half the required return goes to price growth
    growth_rate = rate / 2

    # Half the required return goes to dividends
    dividend_yield = rate / 2

    # Investment value after price growth
    dividend_stock_value = principal * (1 + growth_rate) ** years

    # Total dividends received, assuming annual cash payouts
    # and a constant yield on each year's beginning value
    total_dividends = 0
    current_value = principal

    for year in range(1, years + 1):

        annual_dividend = current_value * dividend_yield

        total_dividends += annual_dividend

        current_value = current_value * (1 + growth_rate)

    # Total wealth includes stock value and cash dividends
    total_wealth = dividend_stock_value + total_dividends

    # Total investment profit
    dividend_profit = total_wealth - principal

    print(f"Annual Growth Rate: {growth_rate * 100:.2f}%")
    print(f"Annual Dividend Yield: {dividend_yield * 100:.2f}%")

    print(f"\nFinal Stock Value: ${dividend_stock_value:,.2f}")
    print(f"Total Cash Dividends: ${total_dividends:,.2f}")

    print(f"\nTotal Investment Wealth: ${total_wealth:,.2f}")
    print(f"Total Investment Return: ${dividend_profit:,.2f}")

else:
    print("Invalid choice. Please enter 1 or 2.")

