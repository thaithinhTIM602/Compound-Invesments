# PART 2: INVESTMENT INFORMATION

print("\nLet's calculate how your money can grow!")

principal = float(input("How much money are you investing? $"))

rate = float(input("What is your desired return annually (%)? "))

years = int(input("How many years will you invest? "))

# PART 3: COMPOUND INTEREST CALCULATION

# Convert percentage to decimal
rate = rate / 100

# Calculate future value (compounded annually)
future_value = principal * (1 + rate) ** years

# Calculate investment return
investment_return = future_value - principal

